<?xml version="1.0" encoding="utf-8"?>
<!--
    Nhóm quyền SmartStock.
    Mỗi nhóm "kế thừa" (implied_ids) nhóm quyền chuẩn của Odoo, vì vậy ACL và
    record rule chuẩn của Sales / Inventory được áp dụng ở tầng ORM, không chỉ ẩn menu:
      - Nhân viên bán hàng  -> sales_team.group_sale_salesman  (rule "Personal Orders": chỉ thấy đơn của mình)
      - Quản lý kinh doanh  -> sales_team.group_sale_manager + stock.group_stock_user (xem toàn bộ đơn, xem tồn kho)
      - Nhân viên kho       -> stock.group_stock_user (nhập/xuất/điều chuyển, không tạo đơn bán)
      - Quản trị viên       -> tất cả các nhóm trên + stock.group_stock_manager (cấu hình kho, điều chỉnh tồn)
-->
<odoo>
    <record id="module_category_smartstock" model="ir.module.category">
        <field name="name">SmartStock</field>
        <field name="description">Phân quyền hệ thống SmartStock AI</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_smartstock_salesman" model="res.groups">
        <field name="name">Nhân viên bán hàng</field>
        <field name="category_id" ref="module_category_smartstock"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Tạo báo giá/đơn bán của mình, xem sản phẩm và tồn kho hiện có, quản lý khách hàng.</field>
    </record>

    <record id="group_smartstock_warehouse" model="res.groups">
        <field name="name">Nhân viên kho</field>
        <field name="category_id" ref="module_category_smartstock"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('stock.group_stock_user'))]"/>
        <field name="comment">Xử lý phiếu nhập, xuất, điều chuyển nội bộ; xem lịch sử dịch chuyển kho.</field>
    </record>

    <record id="group_smartstock_sales_manager" model="res.groups">
        <field name="name">Quản lý kinh doanh</field>
        <field name="category_id" ref="module_category_smartstock"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_smartstock_salesman')),
            Command.link(ref('sales_team.group_sale_manager')),
            Command.link(ref('stock.group_stock_user')),
        ]"/>
        <field name="comment">Xem toàn bộ đơn bán, giá vốn, báo cáo và dashboard; quản lý sản phẩm.</field>
    </record>

    <record id="group_smartstock_admin" model="res.groups">
        <field name="name">Quản trị viên</field>
        <field name="category_id" ref="module_category_smartstock"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_smartstock_sales_manager')),
            Command.link(ref('group_smartstock_warehouse')),
            Command.link(ref('stock.group_stock_manager')),
            Command.link(ref('base.group_partner_manager')),
        ]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Toàn quyền nghiệp vụ SmartStock và cấu hình kho, sản phẩm.</field>
    </record>
</odoo>
